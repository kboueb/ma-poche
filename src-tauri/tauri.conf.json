{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maPoche",
  "version": "1.8.0",
  "identifier": "com.mapoche.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "maPoche",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' http://localhost:* ws://localhost:* https://*.supabase.co; media-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "category": "Finance"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://cllhgyvomuvyidwwnlto.supabase.co/storage/v1/object/public/updates/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMjZBNkJCNjJCRTBCN0IKUldSN0M3NWl1NlltVTM2QmdraXlzV3B1SWlwdERvZnlzTFdvOUo3UWlZNkQwVEhET1M2b3BYOTMK"
    }
  }
}
